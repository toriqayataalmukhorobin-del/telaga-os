#!/usr/bin/env bash
# ==============================================================================
# Telaga OS - Desktop Session Initializer (High-Stability & Security Engine)
# ==============================================================================

export XDG_CURRENT_DESKTOP="Telaga:GNOME"
export XDG_SESSION_DESKTOP="telaga"
export DESKTOP_SESSION="telaga"
export TELAGA_SESSION="1"
export QT_QPA_PLATFORM="xcb"

# 1. Update D-Bus activation environment
if which dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd --all || dbus-update-activation-environment --all
fi

# 2. Fix X11 default mouse cursor (macOS / standard left pointer instead of 'X' cross)
if which xsetroot >/dev/null 2>&1; then
    xsetroot -cursor_name left_ptr
fi

# 3. Disable screen blanking & DPMS power-off in live session
if which xset >/dev/null 2>&1; then
    xset s off -dpms
fi

# 4. Configure Openbox environment (margins & borderless telaga-panel)
mkdir -p "$HOME/.config/openbox"
if [ ! -f "$HOME/.config/openbox/rc.xml" ]; then
    if [ -f "/etc/xdg/openbox/telaga-rc.xml" ]; then
        cp "/etc/xdg/openbox/telaga-rc.xml" "$HOME/.config/openbox/rc.xml"
    elif [ -f "/usr/share/telaga/openbox-rc.xml" ]; then
        cp "/usr/share/telaga/openbox-rc.xml" "$HOME/.config/openbox/rc.xml"
    elif [ -f "/etc/xdg/openbox/rc.xml" ]; then
        cp "/etc/xdg/openbox/rc.xml" "$HOME/.config/openbox/rc.xml"
    fi
fi

# 5. Start Window Manager (Openbox with automatic respawn)
if which openbox >/dev/null 2>&1; then
    openbox &
elif which xfwm4 >/dev/null 2>&1; then
    xfwm4 &
fi

# 6. Start Compositor (Multi-backend failover: GLX -> XRender -> Software)
if which picom >/dev/null 2>&1; then
    (picom -b --backend glx --vsync 2>/dev/null || \
     picom -b --backend xrender --vsync 2>/dev/null || \
     picom -b 2>/dev/null) &
fi

# 7. Start PolicyKit Authentication Agent (Secure GUI Privilege Elevation)
POLKIT_PATHS=(
    "/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1"
    "/usr/libexec/polkit-gnome-authentication-agent-1"
    "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
)
for agent in "${POLKIT_PATHS[@]}"; do
    if [ -x "$agent" ]; then
        "$agent" &
        break
    fi
done

# 8. Start Network Manager Applet (WiFi & Ethernet tray)
if which nm-applet >/dev/null 2>&1; then
    nm-applet --indicator &
fi

# 9. Start Notification Daemon
if which dunst >/dev/null 2>&1; then
    dunst &
fi

# 10. Supervised Execution of Telaga Desktop Shell in Fullscreen Mode
# If telaga-panel exits unexpectedly, restart it to keep desktop alive
FAIL_COUNT=0
while true; do
    /usr/bin/telaga-panel --fullscreen
    EXIT_CODE=$?
    # Normal exit (user logged out / shutdown)
    if [ $EXIT_CODE -eq 0 ]; then
        break
    fi
    FAIL_COUNT=$((FAIL_COUNT + 1))
    echo "[Telaga Session] telaga-panel exited with code $EXIT_CODE. (fail attempt $FAIL_COUNT)"
    if [ $FAIL_COUNT -ge 5 ]; then
        echo "[Telaga Session] Maximum failures reached. Launching emergency terminal..."
        x-terminal-emulator || alacritty || xterm
        break
    fi
    sleep 1
done
